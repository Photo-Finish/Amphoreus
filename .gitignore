# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environment
.venv/
.venv-oplora/
venv/
env/

# OPLoRA local artifacts (adapters + raw work copies; shaped JSONL is tracked)
tools/oplora/outputs/
tools/oplora/work_copies/
tools/oplora/data/

# Streamlit
.streamlit/

# Runtime / auto-generated state (rebuilt by running the app)
world_runtime/
*.log

# RAG vector store — regenerable with: python build_kb.py --embedding local
.chroma_db/

# Fandom verification cache (regenerable: tools/verify_dialogues_against_fandom.py)
.cache/

# Models — far too large for GitHub (20 GB; GitHub rejects files >100 MB and
# free LFS quota is 1 GB). They stay local and are re-downloadable — exact
# mirror sources & commands in docs/DOWNLOADS.md.
models/

# Per-Heir runtime memory (regenerable conversation state). The canon
# personal-memories.md in each Heir's folder IS tracked.
/*/bond.json
/*/history.jsonl
/*/memories.jsonl
/*/preferences.json
/*/teaching.json

# Local environment config (machine-specific). Copy .env.example and edit.
.env

# HF download cache (inside the project, but not a shipped asset)
models/hf-cache/

# Temp / editor
*.tmp
*.part
.DS_Store
Thumbs.db

# Desktop shell PyInstaller output (rebuild: tools/build_desktop_exe.ps1)
# Root AmphoreusSanctuary.exe may be kept locally for double-click use.
dist/
